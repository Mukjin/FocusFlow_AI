# ─────────────────────────────────────────────────────────────
# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요.
#   cp .env.example .env.local
# .env.local 은 .gitignore 에 있어 커밋되지 않습니다.
# ─────────────────────────────────────────────────────────────

# [필수] Gemini API 키 — 할 일 문구 구체화에 쓰입니다.
# 발급: https://aistudio.google.com/apikey  (무료 등급, 카드 등록 불필요)
# 없어도 앱은 실행되며, 규칙 엔진이 만든 기본 일정만 표시됩니다.
VITE_GEMINI_API_KEY=

# [선택] Supabase — 작성한 플랜을 브라우저 밖에 보관할 때만 필요합니다.
# 설정하지 않으면 저장 기능만 꺼지고 나머지는 정상 동작합니다.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
